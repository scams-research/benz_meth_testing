improper_coeff 1 2.500 -1 2
improper_coeff 2 2.500 -1 2
improper_coeff 3 2.500 -1 2
improper_coeff 4 2.500 -1 2
improper_coeff 5 2.500 -1 2
improper_coeff 6 2.500 -1 2


# Methanol coeffs

mass 13 12.011 1.008 # H 
mass 14 15.999 # O
mass 15 15.035 # Me

# pair_coeff (atom_type) (atom_type) (energy units) (distance units)
pair_coeff 13 13 0.000000 0.0000000 # H
pair_coeff 14 14 0.170000 3.0700000 # O
pair_coeff 15 15 0.207000 3.7750000 # Me

bond_coeff 16 500.0000 0.945
bond_coeff 17 500.0000 1.430

angle_coeff 18 50.000 108.5

group methanol_group type 16 17 18 

fix meth_fix methanol_atom shake 1.0e-6 50 b 16 17 a 18 # insures bonds and angles are rigid for opls-ua jorgensens model of methanol.


variable DT equal 1
variable TDAMP equal 100*${DT}

thermo_style custom step cpu cpuremain temp press etotal density xlo xhi ylo yhi zlo zhi
thermo 1000


fix 1 all nvt temp 290 290 ${TDAMP} 
run 100000

dump prod_2ns all atom 500000 prod_traj/production.atom # sample taken every 500 ps
dump_modify prod_2ns sort id
write_data prod_traj/prod.data

run 1000000 # 1 ns simulation

dump prod_1ns all atom 4 prod_traj/production_1ns.atom # sample taken every 4 fs
dump_modify prod_1ns sort id

run 1000000 # 1 ns run, total simulation time 2 ns