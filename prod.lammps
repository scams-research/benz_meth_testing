pair_coeff 8 8 0.030 2.4200000
pair_coeff 9 9 0.030 2.4200000
pair_coeff 10 10 0.030 2.4200000
pair_coeff 11 11 0.030 2.4200000
pair_coeff 12 12 0.030 2.4200000


bond_coeff       1   469.0000     1.4000 
bond_coeff       2   469.0000     1.4000 
bond_coeff       3   469.0000     1.4000 
bond_coeff       4   469.0000     1.4000 
bond_coeff       5   469.0000     1.4000 
